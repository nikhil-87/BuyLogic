# BuyLogic — AI Purchasing Agent Environment Variables

# Backend Configuration
PORT=8000
HOST=127.0.0.1

# LLM Provider (Optional)
# If provided, the agent can connect to OpenAI GPT-4o for natural language reasoning.
# If omitted, the system automatically uses its high-fidelity autonomous execution engine,
# executing identical tools, constraint validations, and feedback loops with 100% offline reliability.
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
